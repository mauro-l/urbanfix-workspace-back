PORT=3001
NODE_ENV=development

# PostgreSQL connection string.
# Local: postgresql://USER:PASSWORD@127.0.0.1:5432/urbanfix_dev?schema=public
# Neon:  postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/urbanfix_dev?schema=public"

# Direct (unpooled) connection, required by Prisma migrate/generate
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Must be replaced with a long random value outside local development.
JWT_SECRET="change-me"
